# ==============================================================================
# TravelOps AI - Environment Configuration Example
# ==============================================================================

# Application Configuration
PROJECT_NAME="TravelOps AI"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=travelops
POSTGRES_PASSWORD=travelops_secure_password
POSTGRES_DB=travelops
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# Redis Cache & Messaging Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=3600

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME="travel_documents"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=travelops_neo4j_password

# Travel API Providers
FLIGHT_PROVIDER=mock
HOTEL_PROVIDER=mock
BOOKING_PROVIDER=mock
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENVIRONMENT=test

# LLM & AI Agents
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-3-5-sonnet-20240620

# Observability & Metrics
METRICS_ENABLED=true
LOG_LEVEL=INFO
