{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "System Gateway & API Telemetry",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "title": "HTTP Request Rate (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(travelops_http_requests_total[1m])) by (method, status_code)",
          "legendFormat": "{{method}} - {{status_code}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "title": "HTTP Latency (P95 & P99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(travelops_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(travelops_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99 Latency"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "title": "Active In-Flight Requests",
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(travelops_http_active_requests)",
          "legendFormat": "Active Requests"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "title": "5xx Server Error Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(travelops_http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(travelops_http_requests_total[5m])) or vector(0)",
          "legendFormat": "5xx Error Ratio"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 200,
      "title": "Agentic AI & Human-in-the-Loop Safety",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": { "mode": "normal" }
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 9 },
      "id": 5,
      "title": "Agent Workflows Invocations",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(increase(travelops_agent_invocations_total[5m])) by (workflow)",
          "legendFormat": "{{workflow}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 9 },
      "id": 6,
      "title": "Agent Execution Latency (P90)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.90, sum(rate(travelops_agent_execution_duration_seconds_bucket[5m])) by (le, workflow))",
          "legendFormat": "{{workflow}} P90"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 25 }
            ]
          }
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 9 },
      "id": 7,
      "title": "Pending HITL Confirmation Queue",
      "type": "stat",
      "targets": [
        {
          "expr": "travelops_hitl_pending_actions",
          "legendFormat": "Pending Confirmations"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": { "mode": "normal" }
          }
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 9 },
      "id": 8,
      "title": "HITL Operator Decisions",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(increase(travelops_hitl_decisions_total[1h])) by (decision, action_type)",
          "legendFormat": "{{decision}} ({{action_type}})"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 300,
      "title": "RAG Retrieval & Graph Fusion",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 17 },
      "id": 9,
      "title": "RAG Policy Queries Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(travelops_rag_queries_total[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 17 },
      "id": 10,
      "title": "RAG Retrieval Latency (P95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(travelops_rag_retrieval_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Vector/Hybrid Retrieval P95"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars"
          }
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 17 },
      "id": 11,
      "title": "Citations Retrieved per Query",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(travelops_rag_citations_count_bucket[5m])) by (le)",
          "legendFormat": "<= {{le}} citations"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 400,
      "title": "Travel ML & Airline Provider Operations",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 25 },
      "id": 12,
      "title": "ML Flight Offer Ranking Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(travelops_ml_ranking_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Ranking P95"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars"
          }
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 25 },
      "id": 13,
      "title": "Fare Anomalies Detected (Surge / Deals)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(increase(travelops_ml_anomalies_detected_total[1h])) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 25 },
      "id": 14,
      "title": "Provider / GDS Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(travelops_provider_latency_seconds_bucket[5m])) by (le, provider))",
          "legendFormat": "{{provider}} P95"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["travelops", "ai", "rag", "agents", "ml"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "TravelOps AI - Platform Observability",
  "uid": "travelops-overview-dashboard",
  "version": 1
}
